# PostgreSQL via Neon (auth users)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# NextAuth (existing auth)
NEXTAUTH_SECRET=generate-a-long-random-string
NEXTAUTH_URL=http://localhost:3000

# Resend — partner inquiry emails (server-side only)
RESEND_API_KEY=re_xxxxxxxx
# Verified sender in Resend. Until domain is verified, Resend sandbox uses onboarding@resend.dev
RESEND_FROM_EMAIL=NexusQ <onboarding@resend.dev>
PARTNER_INQUIRY_TO=admin@auditionq.com